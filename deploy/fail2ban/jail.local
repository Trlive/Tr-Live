# fail2ban: nginx günlüklerini izleyip tekrarlayan saldırganları ağ düzeyinde (iptables/ufw) engeller.
# /etc/fail2ban/ içine kopyalayın: jail.local → jail.d/trlive.local, filter → filter.d/
[sshd]
enabled = true
maxretry = 4
bantime = 1h

# Hız sınırı aşımı tek başına ağ düzeyinde yasak sebebi DEĞİLDİR: operatör NAT'ı / aynı Wi-Fi arkasındaki onlarca
# meşru kullanıcı tek IP'den görünür; biri sınırı aşınca hepsi 1 saat engelleniyordu. Sınırı aşan istek zaten 429 alır.
# Gerçek bir sel saldırısında elle açın (enabled = true).
[nginx-limit-req]
enabled  = false
port     = http,https
logpath  = /var/log/nginx/error.log
maxretry = 20
findtime = 5m
bantime  = 1h

[trlive-scanners]
enabled  = true
port     = http,https
filter   = trlive-scanners
logpath  = /var/log/nginx/access.log
maxretry = 5
findtime = 10m
bantime  = 24h
